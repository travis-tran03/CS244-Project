// Copy this file to secrets.h (same folder) and fill it in.
// secrets.h is in .gitignore: never commit real credentials.
#pragma once

#define WIFI_SSID   "your-wifi-name"
#define WIFI_PASS   "your-wifi-password"

// IP address of the laptop running server/server.py (run `ipconfig` on it), same port as IOT_PORT.
#define SERVER_URL  "http://192.168.1.50:8000/api/readings"

// Must equal the IOT_SHARED_KEY environment variable you start the server with.
#define SHARED_KEY  "change-me-to-a-long-random-string"

#define DEVICE_ID   "esp32-team-XX"
